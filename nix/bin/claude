#!/usr/bin/env bash

# Guard in front of the real `claude` so an account is always picked
# explicitly. Nested invocations (subagents, hooks, scripts started from a
# running session) inherit CLAUDE_CONFIG_DIR and are passed straight through.

set -euo pipefail

CLAUDE_BIN="${CLAUDE_BIN:-}"
if [[ -z "$CLAUDE_BIN" ]]; then
  for candidate in \
    "$HOME/.nix-profile/bin/claude" \
    /run/current-system/sw/bin/claude \
    /etc/profiles/per-user/"$USER"/bin/claude; do
    if [[ -x "$candidate" ]]; then
      CLAUDE_BIN="$candidate"
      break
    fi
  done
fi

if [[ -n "${CLAUDE_CONFIG_DIR:-}" && -n "$CLAUDE_BIN" ]]; then
  exec "$CLAUDE_BIN" "$@"
fi

cat >&2 <<'USAGE'
claude: no account selected.

  claude-work      work account    (~/.claude-work)
  claude-private   private account (~/.claude-private)

Set CLAUDE_CONFIG_DIR yourself to bypass this guard.
USAGE
exit 1
